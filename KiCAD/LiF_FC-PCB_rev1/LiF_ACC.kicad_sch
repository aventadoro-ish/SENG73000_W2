	(text "ESP32_GPIO"
		(exclude_from_sim no)
		(at 197.866 115.57 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6bf46c68-3476-44fb-989b-5acc3d98b2ec")
	)
	(text "Inputs"
		(exclude_from_sim no)
		(at 64.262 93.218 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "7b1db743-8d0f-4ad0-bda9-b5619d15d859")
	)
	(text "CSB to high puts\nthe IC into I2C mode\nas the default is SPI"
		(exclude_from_sim no)
		(at 148.844 106.172 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "7c88aeff-886e-4e69-bbd2-26641e9c41fe")
	)
	(text "Lithium Firefly - Accelerometer"
		(exclude_from_sim no)
		(at 142.24 18.034 0)
		(effects
			(font
				(size 5.08 5.08)
				(thickness 0.762)
				(bold yes)
			)
		)
		(uuid "82fae2ac-777f-492e-afa9-3897226e05be")
	)
	(text "Power Input"
		(exclude_from_sim no)
		(at 64.008 57.15 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "9e032a2e-cbc3-4e4d-908c-f67a80409ea0")
	)
	(text "SDO to GND sets it\nto address bit 0\n\nThis gives 7-bit\nI2C address of 0x14"
		(exclude_from_sim no)
		(at 147.066 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "b143aac3-e134-4a35-b6ed-3a1dd99180ef")
	)
	(text "Only one INT pin is required\nWe can connect both anyway\nINT1 = free-fall condition\nINT2 = excessive accel or sudden stop (like a crash)"
		(exclude_from_sim no)
		(at 184.15 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d27ac981-d679-4461-bc98-66b8a3ee11c2")
	)
	(text "ESP32_SCL Pin"
		(exclude_from_sim no)
		(at 139.954 113.538 0)
		(effects
