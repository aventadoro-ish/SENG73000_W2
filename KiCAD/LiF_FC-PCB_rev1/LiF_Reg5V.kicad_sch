	(text "leaving mode pin open -> \n-> I2C addr is 0x74, \n-> output is enabled by default\nas per Table 6.2"
		(exclude_from_sim no)
		(at 108.458 87.376 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1a927ec9-554f-49bd-8ec2-bae716670dab")
	)
	(text "Place the VCC capacitor close to the IC \nwith wide and short trace. The GND terminal \nof the VCC capacitor should be directly \nconnected with PGND plane through 3-4 vias"
		(exclude_from_sim no)
		(at 185.166 114.554 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6603178b-ed1d-4c5e-a8bd-daa88297f4a9")
	)
	(text "Place the compensation components as close to the COMP pin \nas possible. Keep the compensation components, feedback \ncomponents, and other sensitive analog circuitry far away \nfrom the power components, switching nodes SW1 and SW2, \nand high-current trace to prevent noise coupling into the\nanalog signals."
		(exclude_from_sim no)
		(at 52.832 128.778 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "dce231d6-8246-4ceb-b242-58bcce8ed53e")
	)
