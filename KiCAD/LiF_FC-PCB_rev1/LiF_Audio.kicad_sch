	(text "Lithium Firefly - Audio Amplifier"
		(exclude_from_sim no)
		(at 147.066 18.288 0)
		(effects
			(font
				(size 5.08 5.08)
				(thickness 0.762)
				(bold yes)
			)
		)
		(uuid "1219593d-9ba4-4c5f-93bc-49d9d55fffa1")
	)
	(text "IC has internal input R of 10k\n\nUsing 100 nF cap gives:\n\nFc = 1/((2pi)(RC))\n\nFc 1/((2pi)(100n * 10k))\n\nFc = 160 Hz\n\nThis is DC cutoff Freq (hence the caps)."
		(exclude_from_sim no)
		(at 155.194 103.378 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "28cd4c6c-1321-451f-ab54-7cbc5dd5e9c2")
	)
	(text "SPEAKER OUTPUT (ideally 4-Ohm)"
		(exclude_from_sim no)
		(at 248.158 142.748 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "29e411b5-0d5c-4459-8b67-f5ab353f4eb6")
	)
	(text "As per datasheet \n\"typical application\""
		(exclude_from_sim no)
		(at 205.232 93.726 0)
		(effects
