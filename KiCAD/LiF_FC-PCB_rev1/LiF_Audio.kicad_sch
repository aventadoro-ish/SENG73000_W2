	(text "100k -> 73.2k\nSimplify BOM"
		(exclude_from_sim no)
		(at 215.392 152.908 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "69909a4a-65a8-41f5-979c-6549b93ef538")
	)
	(text "LPF filter setup as the I2S can use PDM \n(pulse data modulation)\n\n4.7nF and 2.2kOhm produce an Fc of 15.4 kHz. \nCheck NK logbook (2026-07-10) for more detail.\n\nA 1.8 nF can be used as well to give a cutoff \nfrequency of 40 kHz cutoff very high frequency \nnoise but allow higher pitches (like 15k + lol)"
		(exclude_from_sim no)
		(at 54.102 94.234 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "70c72acd-4213-4695-b648-23b54313a300")
	)
	(text "Variable gain (limit \noutput current from \nfilter that is \nentering the IC to \nreduce gain)"
		(exclude_from_sim no)
		(at 115.57 91.186 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8aff5870-fddc-4bfa-858d-c83e4ceaaaa2")
	)
	(text "Low-Pass Filter"
		(exclude_from_sim no)
		(at 77.216 77.47 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "a98b27c1-4259-4165-a8da-12a85189bb24")
	)
	(text "ESP32 GPIO chosen as I2S \nPDM data\n=  ESP_AUDIO_PDM_DATA\n\nESP32 GPIO chosen as \nI2S PDM clock\n= ESP_AUDIO_PDM_CLK"
		(exclude_from_sim no)
		(at 18.796 107.696 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b2254eac-7715-4c8b-aa23-ed1911192198")
	)
	(text "ESP Audio out -> double RC filter (tuned at 15 kHz) -> DAC -> amplifier -> speaker\n"
		(exclude_from_sim no)
		(at 151.384 25.908 0)
		(effects
			(font
				(size 2.2 2.2)
			)
		)
		(uuid "c109adff-eb22-4fab-af2c-a9b3474a5ea4")
	)
	(text "AC-Coupling"
		(exclude_from_sim no)
		(at 174.752 77.978 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "c523ebc5-511d-4599-a84d-4932a138ef54")
	)
	(text "LPF to let low frequency pass while cutting \noff high switching frequency from ESPs pin\n\nFc = 1 / (2pi * sqrt(RC))\\\n\nLet Fc = 15 kHz (to cut out high frequency \nnoise; 15 kHz is good enough)\n\nLet's find values. \n\nLet C = 4.7 nF, find R\n\nUsing the above formula,\n\nR = 2.2k (at least for common values)\n\nAnd the final cutoff frequency is 15.4 kHz\n\n\n\n\n\n\n\n"
		(exclude_from_sim no)
		(at 55.372 181.864 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "cb9fb460-4bb0-4bb2-b8b0-5c86402a860e")
	)
