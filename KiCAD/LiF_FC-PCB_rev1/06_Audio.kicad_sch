	(text "Variable gain (limit output current from filter\nthat is entering the IC to reduce gain)"
		(exclude_from_sim no)
		(at 101.6 78.232 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0640d761-0dd9-4336-a57c-f79a9d893618")
	)
	(text "This does NOT have a footprint!!\n\nI'm not sure what terminals you like. "
		(exclude_from_sim no)
		(at 243.586 92.456 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "197c80a3-4c9c-4efe-ba69-78aba92f04c1")
	)
	(text "ESP32 GPIO chosen as I2S PDM data\n=  ESP_AUDIO_PDM_DATA\n\nESP32 GPIO chosen as I2S PDM clock\n= ESP_AUDIO_PDM_CLK"
		(exclude_from_sim no)
		(at 18.796 73.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1defa608-46c6-42dc-afa7-9c37824de879")
	)
	(text "LPF to let low frequency pass while cutting off high switching frequency from ESPs pin\n\nFc = 1 / (2pi * sqrt(RC))\\\n\nLet Fc = 15 kHz (to cut out high frequency noise; 15 kHz is good enough)\n\nLet's find values. \n\nLet C = 4.7 nF, find R\n\nUsing the above formula,\n\nR = 2.2k (at least for common values)\n\nAnd the final cutoff frequency is 15.4 kHz\n\n\n\n\n\n\n\n"
		(exclude_from_sim no)
		(at 15.748 137.922 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "715df5bb-5f03-461d-b214-fcf85aaf535e")
	)
	(text "LPF filter setup as the I2S can use PDM (pulse data modulation)\n\n4.7nF and 2.2kOhm produce an Fc of 15.4 kHz. \nCheck my logbook (2026-07-10) for more detail.\n\nA 1.8 nF can be used as well to give a cutoff frequency of 40 kHz \ncutoff very high frequency noise but allow higher pitches (like 15k + lol)"
		(exclude_from_sim no)
		(at 65.786 44.196 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8b24315d-9780-42f6-ba84-6e3fc6203a50")
	)
	(text "As per datasheet \"typical application\""
		(exclude_from_sim no)
		(at 171.958 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b19d0618-a3dd-47a0-ab8f-9a3f538e9c5e")
	)
	(text "SPEAKER OUTPUT (ideally 4-Ohm)"
		(exclude_from_sim no)
		(at 244.856 79.756 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b551641d-f767-4d4c-bc59-04e4d366b138")
	)
	(text "Sheet 06 - Audio\n\nESP Audio out -> double RC filter (tuned at 15 kHz) -> DAC -> amplifier -> speaker\n"
		(exclude_from_sim no)
		(at 151.13 21.59 0)
		(effects
			(font
				(size 2.2 2.2)
			)
		)
		(uuid "b752737e-4611-4267-be5c-f604a5c2f30f")
	)
	(text "IC has internal input R of 10k\n\nUsing 100 nF cap gives:\n\nFc = 1/((2pi)(RC))\n\nFc 1/((2pi)(100n * 10k))\n\nFc = 160 Hz\n\nThis is DC cutoff Freq (hence the caps)."
		(exclude_from_sim no)
		(at 143.51 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "cbea3090-2079-4b84-822b-ddbba06f09db")
	)
