{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deploy LiF_SC to Raspberry Pi",
            "type": "shell",
            "command": "scp",
            "args": [
                "-r",
                "${workspaceFolder}/RPi/LiF_SC/.",
                "rita@LiF.local:/home/rita/LiF_SC/"
            ],
            "windows": {
                "args": [
                    "-r",
                    "${workspaceFolder}\\RPi\\LiF_SC\\.",
                    "rita@LiF.local:/home/rita/LiF_SC/"
                ]
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}